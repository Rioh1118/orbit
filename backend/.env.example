# Backend env example.

# --- Database ---
DATABASE_URL=postgres://orbit:orbit_dev@localhost:5432/orbit?sslmode=disable

# --- Server ---
PORT=8080
LOG_LEVEL=info  # debug / info / warn / error

# --- Auth ---
# APIキーのハッシュ化に使う salt（本番では Secret Manager で管理）
API_KEY_SALT=change-me-in-production

# --- CORS ---
CORS_ORIGIN=http://localhost:5173
