# Orbit shared env example.
# Copy to .env and fill in.
# backend と frontend それぞれにも .env.example があるのでそちらも参照。

# --- Database ---
DATABASE_URL=postgres://orbit:orbit_dev@localhost:5432/orbit?sslmode=disable

# --- API ---
# 本番では Cloud Run の URL に置き換え
API_BASE_URL=http://localhost:8080

# --- Figma MCP ---
# https://www.figma.com/developers/api#access-tokens で Personal Access Token を発行
# .mcp.json から ${FIGMA_API_KEY} として参照される
FIGMA_API_KEY=figd_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
